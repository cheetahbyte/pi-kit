{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "bun"]
  },
  "include": ["packages/*/index.ts", "packages/*/src/**/*.ts", "packages/*/test/**/*.ts"]
}
