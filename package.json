{
  "name": "@cheetahbyte/pi-kit",
  "version": "0.3.0",
  "description": "A batteries-included set of Pi extensions: todo, hooks, stats, footer, header, web search, and more.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheetahbyte/pi-kit.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "workspaces": [
    "packages/*"
  ],
  "files": [
    "packages/*/src",
    "packages/*/snippets",
    "!**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./packages/*/src/index.ts",
      "./node_modules/@cheetahbyte/pi-footer/src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "pack": "sh scripts/pack-kit.sh",
    "set-version": "node scripts/version.mjs"
  },
  "dependencies": {
    "@cheetahbyte/pi-footer": "^0.5.2",
    "@earendil-works/pi-schema": "^1.5.0"
  },
  "bundledDependencies": [
    "@cheetahbyte/pi-footer"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": ">=1.5.0",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/bun": "^1",
    "@types/node": "^22",
    "typescript": "^7"
  }
}
