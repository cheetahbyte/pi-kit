{
  "name": "@cheetahbyte/pi-ask-user-question",
  "version": "0.3.0",
  "description": "Pi extension that registers ask_user_question for structured multiple-choice questions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheetahbyte/pi-kit.git",
