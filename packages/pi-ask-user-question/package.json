  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@earendil-works/pi-tui": "^1.0.2",
    "@types/bun": "^1",
    "typebox": "^1",
    "typescript": "^7"
  }
}
