{
  "name": "@cheetahbyte/pi-snippets",
  "version": "0.3.0",
  "description": "Pi extension that adds reusable text before or after your messages.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheetahbyte/pi-kit.git",
    "directory": "packages/pi-snippets"
  },
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "src",
    "snippets",
    "!src/**/*.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@earendil-works/pi-tui": "^1.0.2",
    "@types/node": "^22",
    "typescript": "^7"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
